# ─── Add these to your existing .env ─────────────────────────────────────────

# ── Reverb (local) ────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=802355
REVERB_APP_KEY=xdmgxwtdchqi9oyjqlpm
REVERB_APP_SECRET=fstblhpvwf6rbal7nbjs

# PHP internal connection → goes directly to reverb container
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser connection → goes through nginx container
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http

# ── TURN (local) ──────────────────────────────────────────────────────────────
# Find your LAN IP: ip route get 1 | awk '{print $7; exit}'
TURN_EXTERNAL_IP=192.168.1.100
TURN_REALM=defcomm.local
TURN_USERNAME=defcomm
TURN_PASSWORD=StrongPassword123

# Passed to MeetController for ICE server config
VITE_TURN_HOST=localhost
VITE_TURN_PORT=3478
VITE_TURN_USERNAME=defcomm
VITE_TURN_PASSWORD=StrongPassword123
