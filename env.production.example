# ─── Add these to your production .env ───────────────────────────────────────

# ── Reverb (production) ───────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=802355
REVERB_APP_KEY=xdmgxwtdchqi9oyjqlpm
REVERB_APP_SECRET=fstblhpvwf6rbal7nbjs

# PHP internal connection → goes directly to Reverb process (not through Nginx)
